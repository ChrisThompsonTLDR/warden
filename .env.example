# Warden Environment Configuration
# =================================
# Copy this file to .env and configure the values below.

# Required: OpenAI API key for embeddings and completions
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required: Shared secret for MCP authentication
# Generate a secure key with: php -r "echo bin2hex(random_bytes(32));"
# This key protects MCP endpoints from unauthorized access.
WARDEN_SHARED_KEY=

# Optional: Deepwiki server URL
# Default: http://localhost:8001 (local Docker container)
# Change this if running Deepwiki on a different host/port.
# WARDEN_DEEPWIKI_URL=http://localhost:8001

# Optional: Repository name used in Deepwiki project IDs
# Default: basename of the project directory
# Project IDs follow the format: <repo>-<branch>
# WARDEN_REPO_NAME=myapp

# Optional: Root directory for Warden data
# Default: .warden in the project root
# This directory contains worktrees, databases, indexes, and history.
# WARDEN_ROOT=/path/to/.warden

# Optional: Embeddings provider
# Default: openai
# Supported: openai, local (for FAISS-only embeddings)
# WARDEN_EMBEDDINGS_PROVIDER=openai

# Optional: Embeddings model
# Default: text-embedding-3-small
# See OpenAI docs for available models.
# WARDEN_EMBEDDINGS_MODEL=text-embedding-3-small

# Optional: Enable/disable MCP server
# Default: true
# Set to false to disable MCP endpoints entirely.
# WARDEN_MCP_ENABLED=true

# Optional: MCP endpoint path
# Default: /mcp/warden
# Change this to customize the MCP server URL.
# WARDEN_MCP_PATH=/mcp/warden

# Optional: Maximum commits to index for history RAG
# Default: 1000
# Increase for larger repositories with important history.
# WARDEN_HISTORY_MAX_COMMITS=1000

# Optional: Include diffs in commit history
# Default: false
# Warning: This significantly increases index size.
# WARDEN_HISTORY_INCLUDE_DIFFS=false

# Optional: Maximum diff size to include (bytes)
# Default: 10000
# Only applies when WARDEN_HISTORY_INCLUDE_DIFFS=true.
# WARDEN_HISTORY_MAX_DIFF_SIZE=10000

# Staging Database Configuration
# ==============================
# Warden creates per-branch staging databases automatically.
# The path is resolved at runtime based on the current Git branch:
#   .warden/<branch>/database/staging.sqlite
#
# To use a branch-specific staging database in your application:
#
# 1. In config/database.php, add a 'staging' connection:
#
#    'staging' => [
#        'driver' => 'sqlite',
#        'database' => env('WARDEN_STAGING_DB'),
#        'prefix' => '',
#        'foreign_key_constraints' => env('DB_FOREIGN_KEYS', true),
#    ],
#
# 2. Use the Warden helper to get the path:
#
#    use Warden\Services\BranchManager;
#
#    $branchManager = app(BranchManager::class);
#    $dbPath = $branchManager->getStagingDatabasePath($branchManager->getCurrentBranch());
#
# 3. Or set WARDEN_STAGING_DB in your .env:
#
#    WARDEN_STAGING_DB=.warden/main/database/staging.sqlite
